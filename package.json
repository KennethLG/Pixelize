{
  "name": "pixelize",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Turns fake (AI generated) pixel art into real pixel art: grid detection, palette, editor, spritesheet animation and exports",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/postbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc",
    "cli": "tsx cli/pixelize.ts",
    "image": "node cli/generate-image.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "main": "electron/main.cjs",
  "author": "KennethLG",
  "build": {
    "appId": "com.pixelize.app",
    "productName": "Pixelize",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/desktop/**",
      "build/icon.png",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
